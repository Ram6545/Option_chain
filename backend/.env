# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=optionchain

# NSE (National Stock Exchange) API Configuration
# The NSE API is used for fetching real-time option chain contract info,
# strike prices, expiry dates, and underlying prices.
# No API key is required for the public NSE endpoints used.
NSE_API_BASE_URL=https://www.nseindia.com
NSE_API_TIMEOUT=10000
NSE_CACHE_TTL_SECONDS=60

# Market Data API Configuration (placeholder for real API integration)
# MARKET_DATA_API_KEY=your_api_key_here
# MARKET_DATA_API_URL=https://api.example.com/v1

# Data Refresh Interval (in seconds)
REFRESH_INTERVAL=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
